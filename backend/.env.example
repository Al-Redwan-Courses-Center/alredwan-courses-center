# Django Settings
DJANGO_SECRET_KEY=
DEBUG= #True or False
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Local Development)
DATABASE_ENGINE=postgresql_psycopg2
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432

# For Render deployment (overrides individual DB settings above)
# DATABASE_URL=postgres://user:password@host:port/database

# Redis Configuration
# Local Docker: redis://redis:6379
# Render: Will be set automatically via render.yaml
REDIS_URL=redis://redis:6379

# Cloudinary Configuration (Required for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Image Upload Settings (optional - defaults are set)
MAX_IMAGE_SIZE_MB=5
IMAGE_COMPRESSION_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
TARGET_IMAGE_SIZE_KB=500

# Production Security (set these in Render dashboard)
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# RENDER_EXTERNAL_HOSTNAME is automatically set by Render
